# .fafignore — Exclude files/directories from .faf context
# Similar to .gitignore syntax

# Dependencies and build outputs
node_modules/
dist/
build/
coverage/

# Python environments
__pycache__/
venv/
.venv/

# IDE and system files
.vscode/
.idea/
.DS_Store

# Sensitive files
.env
.env.*
*.key
*.pem

# Logs and temporary files
*.log
logs/
tmp/
temp/

# Large media files
*.jpg
*.png
*.mp4
*.pdf
